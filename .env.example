# ==============================================================================
# Variables de Entorno - SNAF Organigrama
# ==============================================================================
# En Coolify, configure estas variables en la pestaña "Environment Variables" de la aplicación.

# Clave secreta de Django (Genere una cadena aleatoria segura en producción)
SECRET_KEY=clave-secreta-larga-y-segura-para-produccion-snaf-2026

# Modo depuración (Debe ser False en producción)
DEBUG=False

# Dominios o IPs permitidos separados por comas (o * en entornos con Traefik)
ALLOWED_HOSTS=*

# Orígenes confiables para CSRF en peticiones HTTPS detrás del proxy Coolify
# Reemplace "tu-dominio.com" por el dominio público que le asigne Coolify:
CSRF_TRUSTED_ORIGINS=https://tu-dominio.com,https://*.coolify.app,http://localhost:8000

# Directorio de persistencia para la base de datos SQLite (mapeado en /app/data en Docker)
DATA_DIR=/app/data
